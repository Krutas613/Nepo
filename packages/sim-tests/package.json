{
  "name": "@nepo/sim-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Headless sweeps, invariants, property tests, regression snapshots for the Nepo sim.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sweep": "tsx src/cli.ts"
  },
  "dependencies": {
    "@nepo/sim": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15"
  }
}
